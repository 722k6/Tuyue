+}
+.car-series {
+  color: #647386;
+}
+.car-price {
+  font-size: 1.1rem;
+  font-weight: 700;
+  color: #b14b25;
+}
+.empty-state {
+  text-align: center;
+}
+@media (max-width: 760px) {
+  .car-filters {
+    grid-template-columns: 1fr;
+  }
